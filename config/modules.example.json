        "device": "hw:2,0",
        "sample_rate_hz": 44100,
        "channels": 1,
        "sample_format": "S16_LE",
        "quiet_seconds": 3,
        "spoken_seconds": 3
      },
      "pump_queue_frames": 50,
      "pump_queue_policy": "bounded_recent_audio_drop_oldest",
      "frame_ownership": "immutable_bytes_copy_at_each_boundary",
      "partial_read_policy": "accumulate_losslessly_until_complete_frame",
      "empty_read_policy": "classify_alive_stdout_close_eof_and_dead_process_without_zero_fill",
      "stale_drain_policy": "reset_epoch_discards_only_queued_and_inflight_pre_boundary_frames",
      "stderr_policy": "separate_bounded_drain_never_mixed_with_pcm_stdout",
      "duplicate_frame_policy": "fail_closed_on_pathological_identical_non_silent_run",
      "process_liveness_policy": "pid_poll_eof_and_exit_status_are_health_authority",
      "format_reporting_policy": "requested_contract_separate_from_negotiated_measurement",
      "diagnostic_counters": [
        "total_low_level_reads",
        "valid_full_pcm_frames",
        "partial_reads",
        "accumulated_partial_bytes",
        "empty_reads",
        "eof_count",
        "unexpected_eof_count",
        "read_errors",
        "discarded_bytes",
        "zero_filled_bytes",
        "repeated_frame_hashes",
        "maximum_consecutive_repeated_non_silent_frames",
        "pathological_duplicate_frame_detected",
        "maximum_consecutive_tiny_rms_frames",
        "mutable_buffer_reuse_detected",
        "valid_microphone_bytes_delivered_to_vad",
        "queue_overflow_dropped_frames",
        "candidate_reset_discarded_frames",
        "process_pid",
        "process_exit_status"
      ],
      "hardware_prerequisite": "scripts/manual_diagnose_persistent_pcm.py"
    },
    "calibration_enabled": true,
    "calibration_duration_seconds": 0.75,
    "speech_start_rms": 200,
    "speech_continue_rms": 160,
    "silence_rms": 120,
