        "channels": 1,
        "sample_format": "S16_LE",
        "sample_width_bytes": 2,
        "frame_duration_ms": 20,
        "samples_per_frame": 320,
        "frame_bytes": 640
      },
      "transport_strategy": "plughw_16000_s16le_mono_continuous_stdout_pump",
